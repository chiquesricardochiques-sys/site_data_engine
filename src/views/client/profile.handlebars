<div class="profile-container">

    {{#if logado}}

        <!-- =====================================================
             CABEÇALHO DO PERFIL
             ===================================================== -->

        <div class="profile-avatar">
            <i class="fas fa-user-circle"></i>
        </div>

        <h1>Meu Perfil</h1>

        <p class="profile-subtitle">
            Seus dados pessoais
        </p>


        <!-- =====================================================
             MENSAGEM DE SUCESSO
             ===================================================== -->

        {{#if success}}

            <div class="message success">

                <i class="fas fa-check-circle"></i>

                <span>
                    {{success}}
                </span>

            </div>

        {{/if}}


        <!-- =====================================================
             MENSAGEM DE ERRO
             ===================================================== -->

        {{#if error}}

            <div class="message error">

                <i class="fas fa-exclamation-triangle"></i>

                <span>
                    {{error}}
                </span>

            </div>

        {{/if}}


        <!-- =====================================================
             DADOS DO CLIENTE
             ===================================================== -->

        <div class="profile-form">


            <!-- =================================================
                 NOME
                 ================================================= -->

            <div class="input-group">

                <label for="nome">
                    Nome Completo
                </label>

                <div class="input-wrapper">

                    <i class="fas fa-id-card"></i>

                    <input
                        type="text"
                        id="nome"
                        value="{{cliente.nome}}"
                        readonly
                    >

                </div>

            </div>


            <!-- =================================================
                 E-MAIL
                 ================================================= -->

            <div class="input-group">

                <label for="email">
                    E-mail
                </label>

                <div class="input-wrapper">

                    <i class="fas fa-envelope"></i>

                    <input
                        type="email"
                        id="email"
                        value="{{cliente.email}}"
                        readonly
                    >

                </div>

            </div>


            <!-- =================================================
                 WHATSAPP
                 ================================================= -->

            <div class="input-group">

                <label for="telInput">
                    WhatsApp
                </label>

                <div class="input-wrapper">

                    <i class="fab fa-whatsapp"></i>

                    <input
                        type="tel"
                        id="telInput"
                        value="{{cliente.telefone}}"
                        readonly
                    >

                </div>

            </div>


            <!-- =================================================
                 STATUS DA CONTA
                 ================================================= -->

            <div class="input-group">

                <label for="status">
                    Status da Conta
                </label>

                <div class="input-wrapper">

                    <i class="fas fa-user-check"></i>

                    <input
                        type="text"
                        id="status"
                        value="{{cliente.status}}"
                        readonly
                    >

                </div>

            </div>


            <!-- =================================================
                 STATUS DO E-MAIL
                 ================================================= -->

            <div class="input-group">

                <label>
                    E-mail
                </label>

                <div class="account-status">

                    {{#if cliente.email_verificado}}

                        <i class="fas fa-check-circle"></i>

                        <span>
                            E-mail verificado
                        </span>

                    {{else}}

                        <i class="fas fa-exclamation-circle"></i>

                        <span>
                            E-mail não verificado
                        </span>

                    {{/if}}

                </div>

            </div>


            <!-- =================================================
                 AVISO
                 ================================================= -->

            <div class="profile-info">

               <!-- =====================================================
                BOTÃO ALTERAR PERFIL
                ===================================================== -->

                <a
                    href="profile/edit"
                    class="profile-edit-btn"
                >
                    <i class="fas fa-user-edit"></i>

                    <span>
                        Alterar Perfil
                    </span>
                </a>
            </div>

            <a
                href="/"
                class="back-link"
            >

                <i class="fas fa-chevron-left"></i>

                <span>
                    Painel Inicial
                </span>

            </a>
        </div>


    {{else}}


        <!-- =====================================================
             USUÁRIO NÃO LOGADO
             ===================================================== -->

        <div class="profile-avatar">

            <i class="fas fa-user-circle"></i>

        </div>


        <h1>
            Acesse seu perfil
        </h1>


        <p class="profile-description">
            Entre na sua conta para consultar
            seus dados pessoais.
        </p>


        <!-- =====================================================
             BOTÃO LOGIN
             ===================================================== -->

        <a
            href="/login"
            class="profile-login-btn"
        >

            <i class="fas fa-sign-in-alt"></i>

            <span>
                Fazer Login
            </span>

        </a>


        <!-- =====================================================
             BOTÃO CRIAR CONTA
             ===================================================== -->

        <a
            href="/register"
            class="profile-register-btn"
        >

            <i class="fas fa-user-plus"></i>

            <span>
                Criar Minha Conta
            </span>

        </a>


    {{/if}}


    <!-- =========================================================
         VOLTAR PARA O PAINEL
         ========================================================= -->

    

</div>


<!-- =============================================================
     MÁSCARA DO TELEFONE
     ============================================================= -->

<script>

    const telInput = document.getElementById("telInput");

    if (telInput) {

        let numeros = telInput.value
            .replace(/\D/g, "")
            .slice(0, 11);

        if (numeros.length > 7) {

            telInput.value =
                "(" +
                numeros.slice(0, 2) +
                ") " +
                numeros.slice(2, 7) +
                "-" +
                numeros.slice(7);

        } else if (numeros.length > 2) {

            telInput.value =
                "(" +
                numeros.slice(0, 2) +
                ") " +
                numeros.slice(2);

        } else if (numeros.length > 0) {

            telInput.value =
                "(" +
                numeros;

        }

    }

</script>