<div class="login-card">

    <div class="header">
        <div class="logo-circle">
            <i data-lucide="lock-keyhole"></i>
        </div>

        <h2>Esqueci minha senha</h2>
        <p class="subtitle">
            Informe seu e-mail e escolha uma nova senha.
            Enviaremos um código para confirmar a alteração.
        </p>
    </div>

    {{#if error}}
        <div class="error-toast" role="alert">
            <i data-lucide="alert-circle" style="width: 16px;"></i>
            {{error}}
        </div>
    {{/if}}

    <form action="/forgot-password" method="POST">

        <div class="form-group">
            <div class="input-wrapper">
                <i data-lucide="mail"></i>
                <input
                    type="email"
                    name="email"
                    value="{{email}}"
                    required
                    autocomplete="email"
                    placeholder="Seu e-mail cadastrado"
                >
            </div>
        </div>

        <div class="form-group">
            <div class="input-wrapper">
                <i data-lucide="lock"></i>
                <input
                    type="password"
                    name="senha"
                    required
                    minlength="8"
                    autocomplete="new-password"
                    placeholder="Nova senha (mínimo 8 caracteres)"
                >
            </div>
        </div>

        <div class="form-group">
            <div class="input-wrapper">
                <i data-lucide="shield-check"></i>
                <input
                    type="password"
                    name="confirmar_senha"
                    required
                    minlength="8"
                    autocomplete="new-password"
                    placeholder="Confirme a nova senha"
                >
            </div>
        </div>

        <button type="submit">
            Enviar código
            <i data-lucide="arrow-right" style="width: 18px;"></i>
        </button>

    </form>

    <div class="footer-links" style="justify-content: center;">
        <p>
            Lembrou a senha?
            <a href="/login"
               style="color:var(--primary-blue);font-weight:600;">
                Voltar ao login
            </a>
        </p>
    </div>

</div>
